<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="HoYoShadeHub.Features.Toolbox.DiagnosticToolWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:HoYoShadeHub.Language"
             xmlns:local="using:HoYoShadeHub.Features.Toolbox"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:HoYoShadeHub.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  Title Bar  -->
        <Grid x:Name="CustomTitleBar"
              Grid.Row="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              SizeChanged="CustomTitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Width="16"
                   Height="16"
                   Margin="16,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Source="ms-appx:///Assets/logo.ico" />

            <TextBlock Grid.Column="1"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Text="{x:Bind lang:Lang.DiagnosticTool_Title}" />
        </Grid>

        <!--  Main Content  -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="20">

                <!--  Header  -->
                <StackPanel Spacing="6">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}"
                               Text="{x:Bind lang:Lang.DiagnosticTool_Title}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.DiagnosticTool_Subtitle}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!--  Notification InfoBar  -->
                <InfoBar x:Name="InfoBar_Status"
                         IsClosable="True"
                         IsOpen="False" />

                <!--  Action Bar  -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Height="38"
                            Padding="16,0,16,0"
                            BorderThickness="0"
                            Click="Button_CopyReport_Click"
                            CornerRadius="6"
                            IsEnabled="{x:Bind IsNotLoading}"
                            Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="15" Glyph="&#xE8C8;" />
                            <TextBlock Text="{x:Bind lang:Lang.DiagnosticTool_CopyReport}" />
                        </StackPanel>
                    </Button>

                    <Button Height="38"
                            Padding="16,0,16,0"
                            Click="Button_ExportZip_Click"
                            CornerRadius="6"
                            IsEnabled="{x:Bind IsNotLoading}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="15" Glyph="&#xE898;" />
                            <TextBlock Text="{x:Bind lang:Lang.DiagnosticTool_ExportZip}" />
                        </StackPanel>
                    </Button>

                    <Button Height="38"
                            Padding="14,0,14,0"
                            Click="Button_OpenLogFolder_Click"
                            CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="15" Glyph="&#xED25;" />
                            <TextBlock Text="{x:Bind lang:Lang.DiagnosticTool_OpenLogFolder}" />
                        </StackPanel>
                    </Button>

                    <Button Height="38"
                            Padding="12,0,12,0"
                            Click="Button_Refresh_Click"
                            CornerRadius="6"
                            IsEnabled="{x:Bind IsNotLoading}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="{x:Bind lang:Lang.DiagnosticTool_Refresh}" />
                        </StackPanel>
                    </Button>

                    <ProgressRing Width="20"
                                  Height="20"
                                  VerticalAlignment="Center"
                                  IsActive="{x:Bind IsLoading}"
                                  Visibility="{x:Bind LoadingVisibility}" />
                </StackPanel>

                <!--  Card 1: 硬件与显示配置  -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Glyph="&#xE9F9;" />
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_SectionHardware}" />
                        </StackPanel>

                        <Grid ColumnSpacing="24" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Cpu}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind CpuText}" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Memory}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind MemoryText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Gpu}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind GpuText}"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Display}" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind DisplayText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Card 2: 操作系统与运行环境  -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Glyph="&#xE7EE;" />
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_SectionSystem}" />
                        </StackPanel>

                        <Grid ColumnSpacing="24" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_OS}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind OsText}" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Runtime}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind RuntimeText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Uptime" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind UptimeText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Card 3: 启动器与组件状态  -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Glyph="&#xEC7A;" />
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_SectionLauncher}" />
                        </StackPanel>

                        <Grid ColumnSpacing="24" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_LauncherVer}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind LauncherVerText}" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_FrameworkVer}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind FrameworkVerText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_RpcState}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind RpcStateText}" />

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Permissions}" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind PermissionsText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Card 4: 已安装游戏与注入配置  -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Glyph="&#xE7FC;" />
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_SectionGames}" />
                        </StackPanel>

                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind GamesSummaryText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Card 5: 诊断报告与日志预览  -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          Glyph="&#xE9D9;" />
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind lang:Lang.DiagnosticTool_SectionLogs}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_PrivacyNotice}" />
                        </Grid>

                        <TextBox Height="280"
                                 AcceptsReturn="True"
                                 CornerRadius="4"
                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 IsSpellCheckEnabled="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Text="{x:Bind ReportText}"
                                 TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</sf:WindowEx>
