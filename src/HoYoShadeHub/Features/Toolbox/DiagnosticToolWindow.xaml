<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="HoYoShadeHub.Features.Toolbox.DiagnosticToolWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:HoYoShadeHub.Language"
             xmlns:local="using:HoYoShadeHub.Features.Toolbox"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:HoYoShadeHub.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  Title Bar  -->
        <Grid x:Name="CustomTitleBar"
              Grid.Row="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              SizeChanged="CustomTitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Width="16"
                   Height="16"
                   Margin="16,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Source="ms-appx:///Assets/logo.ico" />

            <TextBlock Grid.Column="1"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Text="{x:Bind lang:Lang.DiagnosticTool_Title}" />
        </Grid>

        <!--  Main Content  -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="20">

                <!--  Header  -->
                <StackPanel Spacing="6">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}"
                               Text="{x:Bind lang:Lang.DiagnosticTool_Title}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.DiagnosticTool_Subtitle}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!--  Notification InfoBar  -->
                <InfoBar x:Name="InfoBar_Status"
                         IsClosable="True"
                         IsOpen="False" />

                <!--  Action Bar  -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Height="38"
                            Padding="16,0,16,0"
                            BorderThickness="0"
                            Click="Button_CopyReport_Click"
                            CornerRadius="6"
                            IsEnabled="{x:Bind IsNotLoading}"
                            Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="15" Glyph="&#xE8C8;" />
                            <TextBlock Text="{x:Bind lang:Lang.DiagnosticTool_CopyReport}" />
                        </StackPanel>
                    </Button>

                    <Button Height="38"
                            Padding="16,0,16,0"
                            Click="Button_ExportZip_Click"
                            CornerRadius="6"
                            IsEnabled="{x:Bind IsNotLoading}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="15" Glyph="&#xE898;" />
                            <TextBlock Text="{x:Bind lang:Lang.DiagnosticTool_ExportZip}" />
                        </StackPanel>
                    </Button>

                    <Button Height="38"
                            Padding="14,0,14,0"
                            Click="Button_OpenLogFolder_Click"
                            CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="15" Glyph="&#xED25;" />
                            <TextBlock Text="{x:Bind lang:Lang.DiagnosticTool_OpenLogFolder}" />
                        </StackPanel>
                    </Button>

                    <Button Height="38"
                            Padding="12,0,12,0"
                            Click="Button_Refresh_Click"
                            CornerRadius="6"
                            IsEnabled="{x:Bind IsNotLoading}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="{x:Bind lang:Lang.DiagnosticTool_Refresh}" />
                        </StackPanel>
                    </Button>

                    <ProgressRing Width="20"
                                  Height="20"
                                  VerticalAlignment="Center"
                                  IsActive="{x:Bind IsLoading}"
                                  Visibility="{x:Bind LoadingVisibility}" />
                </StackPanel>

                <!--  Card 1: 硬件与显示配置  -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Glyph="&#xE9F9;" />
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_SectionHardware}" />
                        </StackPanel>

                        <Grid ColumnSpacing="24" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Cpu}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind CpuText}"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Motherboard}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind MotherboardText}"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Memory}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind MemoryText}"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Gpu}" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind GpuText}"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Monitors}" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind MonitorsText}"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="5" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Disks}" />
                            <TextBlock Grid.Row="5" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind DisksText}"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="6" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Audio}" />
                            <TextBlock Grid.Row="6" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind AudioText}"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="7" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Network}" />
                            <TextBlock Grid.Row="7" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind NetworkText}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Card 2: 操作系统与运行环境  -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Glyph="&#xE7EE;" />
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_SectionSystem}" />
                        </StackPanel>

                        <Grid ColumnSpacing="24" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_OS}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind OsText}" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Runtime}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind RuntimeText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Uptime" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind UptimeText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Card 3: 启动器与框架状态  -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Glyph="&#xEC7A;" />
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_SectionLauncher}" />
                        </StackPanel>

                        <!-- 启动器基础信息与框架设置 -->
                        <Grid ColumnSpacing="24" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_LauncherVer}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind LauncherVerText}" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_Permissions}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind PermissionsText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_RpcState}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind RpcStateText}" />

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.HoYoShadeDownloadView_DownloadServer}" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind FrameworkDownloadServerText}" />

                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.SettingPage_JoinPreviewReleaseChannel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind FrameworkPreviewChannelText}" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2" />

                        <!-- HoYoShade 框架详情 -->
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.FileSettingPage_HoYoShadeFramework}" />

                        <!-- HoYoShade 子卡片 -->
                        <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12">
                            <StackPanel Spacing="10">
                                <!-- 卡片头部：名称与状态徽章 -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Glyph="&#xE896;" />
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="HoYoShade" />
                                    </StackPanel>
                                    <!-- 状态徽章 -->
                                    <Border Grid.Column="1"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontSize="10"
                                                      Foreground="{x:Bind HoYoShadeStatusBrush, Mode=OneWay}"
                                                      Glyph="{x:Bind HoYoShadeStatusGlyph, Mode=OneWay}" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{x:Bind HoYoShadeStatusBrush, Mode=OneWay}"
                                                       Text="{x:Bind HoYoShadeStatusText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 已安装详细信息 -->
                                <StackPanel Spacing="10"
                                            Visibility="{x:Bind HoYoShadeInstalledVisibility, Mode=OneWay}">
                                    <!-- 版本信息 -->
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Bind lang:Lang.FileSettingPage_FrameworkVersion}" /><Run Text=": " />
                                            <Run FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind HoYoShadeVersion, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Bind lang:Lang.FileSettingPage_ReShadeVersion}" /><Run Text=": " />
                                            <Run FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind HoYoShadeReShadeVersion, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- 安装路径 -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0"
                                                      FontSize="13"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      Glyph="&#xED25;" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       IsTextSelectionEnabled="True"
                                                       Text="{x:Bind HoYoShadePath, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>

                                    <!-- 存储占用 -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,8">
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon FontSize="13"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              Glyph="&#xEDA2;" />
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{x:Bind lang:Lang.FileSettingPage_TotalSize}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           Text="{x:Bind HoYoShadeTotalSize, Mode=OneWay}" />
                                            </Grid>

                                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5" />

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 着色器及插件 -->
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{x:Bind lang:Lang.FileSettingPage_ShaderAndAddonSize}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Medium"
                                                               Text="{x:Bind HoYoShadeShaderSize, Mode=OneWay}" />
                                                </StackPanel>

                                                <!-- 预设 -->
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{x:Bind lang:Lang.FileSettingPage_PresetSize}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Medium"
                                                               Text="{x:Bind HoYoShadePresetSize, Mode=OneWay}" />
                                                </StackPanel>

                                                <!-- 截图 -->
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{x:Bind lang:Lang.FileSettingPage_ScreenshotSize}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Medium"
                                                               Text="{x:Bind HoYoShadeScreenshotSize, Mode=OneWay}" />
                                                </StackPanel>

                                                <!-- 其它内容 -->
                                                <StackPanel Grid.Column="3" Spacing="2">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{x:Bind lang:Lang.FileSettingPage_OtherContentSize}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Medium"
                                                               Text="{x:Bind HoYoShadeOtherSize, Mode=OneWay}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- OpenHoYoShade 子卡片 -->
                        <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12">
                            <StackPanel Spacing="10">
                                <!-- 卡片头部：名称与状态徽章 -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Glyph="&#xE896;" />
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="OpenHoYoShade" />
                                    </StackPanel>
                                    <!-- 状态徽章 -->
                                    <Border Grid.Column="1"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontSize="10"
                                                      Foreground="{x:Bind OpenHoYoShadeStatusBrush, Mode=OneWay}"
                                                      Glyph="{x:Bind OpenHoYoShadeStatusGlyph, Mode=OneWay}" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{x:Bind OpenHoYoShadeStatusBrush, Mode=OneWay}"
                                                       Text="{x:Bind OpenHoYoShadeStatusText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 已安装详细信息 -->
                                <StackPanel Spacing="10"
                                            Visibility="{x:Bind OpenHoYoShadeInstalledVisibility, Mode=OneWay}">
                                    <!-- 版本信息 -->
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Bind lang:Lang.FileSettingPage_FrameworkVersion}" /><Run Text=": " />
                                            <Run FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind OpenHoYoShadeVersion, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Bind lang:Lang.FileSettingPage_ReShadeVersion}" /><Run Text=": " />
                                            <Run FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind OpenHoYoShadeReShadeVersion, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- 安装路径 -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0"
                                                      FontSize="13"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      Glyph="&#xED25;" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       IsTextSelectionEnabled="True"
                                                       Text="{x:Bind OpenHoYoShadePath, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>

                                    <!-- 存储占用 -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,8">
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon FontSize="13"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              Glyph="&#xEDA2;" />
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{x:Bind lang:Lang.FileSettingPage_TotalSize}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           Text="{x:Bind OpenHoYoShadeTotalSize, Mode=OneWay}" />
                                            </Grid>

                                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5" />

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 着色器及插件 -->
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{x:Bind lang:Lang.FileSettingPage_ShaderAndAddonSize}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Medium"
                                                               Text="{x:Bind OpenHoYoShadeShaderSize, Mode=OneWay}" />
                                                </StackPanel>

                                                <!-- 预设 -->
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{x:Bind lang:Lang.FileSettingPage_PresetSize}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Medium"
                                                               Text="{x:Bind OpenHoYoShadePresetSize, Mode=OneWay}" />
                                                </StackPanel>

                                                <!-- 截图 -->
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{x:Bind lang:Lang.FileSettingPage_ScreenshotSize}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Medium"
                                                               Text="{x:Bind OpenHoYoShadeScreenshotSize, Mode=OneWay}" />
                                                </StackPanel>

                                                <!-- 其它内容 -->
                                                <StackPanel Grid.Column="3" Spacing="2">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{x:Bind lang:Lang.FileSettingPage_OtherContentSize}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Medium"
                                                               Text="{x:Bind OpenHoYoShadeOtherSize, Mode=OneWay}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  Card 4: 网络环境与出口诊断  -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          Glyph="&#xE774;" />
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind lang:Lang.DiagnosticTool_SectionNetwork}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Padding="10,4"
                                        Click="Button_ToggleIpMask_Click"
                                        CornerRadius="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Glyph="{x:Bind IpVisibilityGlyph}" />
                                        <TextBlock FontSize="12" Text="{x:Bind lang:Lang.DiagnosticTool_ToggleIpVisibility}" />
                                    </StackPanel>
                                </Button>

                                <Button Padding="10,4"
                                        Click="Button_RetestWithDoh_Click"
                                        CornerRadius="4"
                                        IsEnabled="{x:Bind IsNotRetestingDoh}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                        <TextBlock FontSize="12" Text="{x:Bind lang:Lang.DiagnosticTool_TestWithDoh}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="24" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_NetworkIpv4}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind NetworkIpv4Text}" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_NetworkLocation}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind NetworkLocationText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_NetworkAsn}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind NetworkAsnText}" />

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_NetworkIpv6}" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind NetworkIpv6Text}" />

                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_NetworkColo}" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind NetworkColoText}" />

                            <TextBlock Grid.Row="5" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_NetworkProxy}" />
                            <TextBlock Grid.Row="5" Grid.Column="1"
                                       FontWeight="Medium"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind NetworkProxyText}" />

                            <TextBlock Grid.Row="6" Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_NetworkConclusion}" />
                            <TextBlock Grid.Row="6" Grid.Column="1"
                                       FontWeight="Medium"
                                       Foreground="{x:Bind NetworkConclusionBrush}"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind NetworkConclusionText}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Card 5: 已安装游戏与注入配置  -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Glyph="&#xE7FC;" />
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_SectionGames}" />
                        </StackPanel>

                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind GamesSummaryText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Card 6: 诊断报告与日志预览  -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          Glyph="&#xE9D9;" />
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind lang:Lang.DiagnosticTool_SectionLogs}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.DiagnosticTool_PrivacyNotice}" />
                        </Grid>

                        <TextBox Height="280"
                                 AcceptsReturn="True"
                                 CornerRadius="4"
                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 IsSpellCheckEnabled="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Text="{x:Bind ReportText}"
                                 TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</sf:WindowEx>
