<UserControl x:Class="HoYoShadeHub.Features.ViewHost.QuickSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="using:HoYoShadeHub.Language"
             xmlns:models="using:HoYoShadeHub.Models"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid Loaded="Grid_Loaded">

        <!-- Installation Status Panel (Top Right) -->
        <StackPanel Canvas.ZIndex="10"
                    Margin="0,48,48,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Spacing="8">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind lang:Lang.HoYoShadeDownloadView_InstallStatus}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    
                    <!-- HoYoShade Status -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" 
                                  FontSize="14" 
                                  Margin="0,0,8,0"
                                  Glyph="{x:Bind IsHoYoShadeInstalled, Mode=OneWay, Converter={StaticResource BoolToInstallGlyphConverter}}" 
                                  Foreground="{x:Bind IsHoYoShadeInstalled, Mode=OneWay, Converter={StaticResource BoolToInstallColorConverter}}" />
                        <TextBlock Grid.Column="1" FontSize="13">
                            <Run Text="HoYoShade"/>
                            <Run Text="{x:Bind HoYoShadeVersionDisplay, Mode=OneWay}" 
                                 Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </TextBlock>
                    </Grid>
                    
                    <!-- OpenHoYoShade Status -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" 
                                  FontSize="14" 
                                  Margin="0,0,8,0"
                                  Glyph="{x:Bind IsOpenHoYoShadeInstalled, Mode=OneWay, Converter={StaticResource BoolToInstallGlyphConverter}}" 
                                  Foreground="{x:Bind IsOpenHoYoShadeInstalled, Mode=OneWay, Converter={StaticResource BoolToInstallColorConverter}}" />
                        <TextBlock Grid.Column="1" FontSize="13">
                            <Run Text="OpenHoYoShade"/>
                            <Run Text="{x:Bind OpenHoYoShadeVersionDisplay, Mode=OneWay}" 
                                 Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Language Selector moved below installation status -->
            <ComboBox Name="ComboBox_Language"
                      MinWidth="200"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="ComboBox_Language_SelectionChanged" />

            <Button HorizontalAlignment="Stretch"
                    Content="{x:Bind lang:Lang.WelcomeView_NetworkSettingsButton}"
                    Click="Button_NetworkSettings_Click" />
        </StackPanel>

        <!-- Main Content Area -->
        <StackPanel Margin="48,0,48,96"
                    VerticalAlignment="Center"
                    Spacing="14"
                    MaxWidth="780"
                    HorizontalAlignment="Left">

            <!-- Title & Subtitle -->
            <StackPanel Spacing="4">
                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           Text="{x:Bind lang:Lang.QuickSetupView_Title}" />
                <TextBlock FontSize="16"
                           FontWeight="Normal"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Text="{x:Bind lang:Lang.QuickSetupView_Subtitle}" />
            </StackPanel>

            <!-- Description Paragraphs -->
            <StackPanel Spacing="6" Margin="0,2,0,0">
                <TextBlock FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.QuickSetupView_Description}"
                           TextWrapping="Wrap" />

                <TextBlock FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap">
                    <Run Text="{x:Bind lang:Lang.QuickSetupView_NetworkCensoredPrefix}" />
                    <Hyperlink Click="Hyperlink_NetworkSettings_Click" UnderlineStyle="None">
                        <Run Text="{x:Bind lang:Lang.WelcomeView_NetworkSettingsButton}" />
                    </Hyperlink>
                    <Run Text="{x:Bind lang:Lang.QuickSetupView_NetworkCensoredSuffix}" />
                </TextBlock>
            </StackPanel>

            <!-- Card 1: Operation Summary Box (with original icon style) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind lang:Lang.QuickSetupView_CardTitle}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Action Item 1: HoYoShade Framework -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  FontSize="18"
                                  Margin="0,2,14,0"
                                  VerticalAlignment="Top"
                                  Glyph="&#xE896;"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind lang:Lang.QuickSetupView_Action1}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind lang:Lang.QuickSetupView_Action1Desc}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- Action Item 2: ReShade Shaders & Addons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  FontSize="18"
                                  Margin="0,2,14,0"
                                  VerticalAlignment="Top"
                                  Glyph="&#xE790;"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind lang:Lang.QuickSetupView_Action2}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind lang:Lang.QuickSetupView_Action2Desc}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Download Action & Progress Control Card (Identical to HoYoShadeDownloadView) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Control Buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <Button Content="{x:Bind StartButtonText, Mode=OneWay}" 
                                    Command="{x:Bind StartInstallCommand}" 
                                    Style="{ThemeResource AccentButtonStyle}" 
                                    IsEnabled="{x:Bind CanStartInstall, Mode=OneWay}"
                                    CornerRadius="6" />
                            
                            <Button Command="{x:Bind StopCommand}"
                                    Visibility="{x:Bind IsDownloading, Mode=OneWay}"
                                    CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="13" Glyph="&#xE71A;" />
                                    <TextBlock Text="{x:Bind lang:Lang.DownloadGamePage_Stop}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Server Selection (Aligned on the right of the control card) -->
                        <StackPanel Grid.Column="2" 
                                    Orientation="Horizontal" 
                                    Spacing="8" 
                                    VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind lang:Lang.HoYoShadeDownloadView_DownloadServer}" 
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox ItemsSource="{x:Bind DownloadServers}" 
                                      SelectedItem="{x:Bind SelectedDownloadServer, Mode=TwoWay}" 
                                      MinWidth="180"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:DownloadServerItem">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" 
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4" 
                                                    Padding="6,2" 
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind LatencyText, Mode=OneWay, Converter={StaticResource WhiteSpaceStringToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind LatencyText, Mode=OneWay}" Foreground="{x:Bind LatencyColor, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" UseLayoutRounding="True" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Progress and Status -->
                    <StackPanel Spacing="4">
                        <ProgressBar Value="{x:Bind OverallProgress, Mode=OneWay}" 
                                     Maximum="100" 
                                     Height="4"
                                     CornerRadius="2" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind StatusMessage, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind SpeedAndProgress, Mode=OneWay}"
                                       FontSize="12"
                                       FontFamily="Consolas"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Unified Bottom Navigation Bar -->
        <Grid Canvas.ZIndex="10"
              Margin="48,0,80,36"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Custom / Advanced Setup Button (Left) -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <TextBlock Text="{x:Bind lang:Lang.QuickSetupView_OrCustomHint}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <Button Command="{x:Bind NavigateToCustomCommand}"
                        IsEnabled="{x:Bind CanNavigateToCustom, Mode=OneWay}"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="13" Glyph="&#xE713;" />
                        <TextBlock Text="{x:Bind lang:Lang.QuickSetupView_CustomInstall}" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Next Step / Enter Main View Button (Right) -->
            <Button Grid.Column="2"
                    Height="40"
                    BorderThickness="0"
                    Command="{x:Bind FinishCommand}"
                    IsEnabled="{x:Bind IsCompleted, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    CornerRadius="8,20,20,8">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,0,6,0">
                    <TextBlock FontSize="14" Text="{x:Bind lang:Lang.WelcomeView_HoYoShadeHubStart}" />
                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                </StackPanel>
            </Button>
        </Grid>

    </Grid>
</UserControl>
