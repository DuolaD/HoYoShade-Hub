<UserControl x:Class="HoYoShadeHub.Features.ViewHost.HoYoShadeDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="using:HoYoShadeHub.Language"
             xmlns:github="using:HoYoShadeHub.Core.Metadata.Github"
             xmlns:models="using:HoYoShadeHub.Models"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid Loaded="Grid_Loaded">


        <!-- Installation Status Panel (Top Right) -->
        <StackPanel Canvas.ZIndex="10"
                    Margin="0,48,48,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Spacing="8">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind lang:Lang.HoYoShadeDownloadView_InstallStatus}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    
                    <!-- HoYoShade Status -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" 
                                  FontSize="14" 
                                  Margin="0,0,8,0"
                                  Glyph="{x:Bind IsHoYoShadeInstalled, Mode=OneWay, Converter={StaticResource BoolToInstallGlyphConverter}}" 
                                  Foreground="{x:Bind IsHoYoShadeInstalled, Mode=OneWay, Converter={StaticResource BoolToInstallColorConverter}}" />
                        <TextBlock Grid.Column="1" FontSize="13">
                            <Run Text="HoYoShade"/>
                            <Run Text="{x:Bind HoYoShadeVersionDisplay, Mode=OneWay}" 
                                 Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </TextBlock>
                    </Grid>
                    
                    <!-- OpenHoYoShade Status -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" 
                                  FontSize="14" 
                                  Margin="0,0,8,0"
                                  Glyph="{x:Bind IsOpenHoYoShadeInstalled, Mode=OneWay, Converter={StaticResource BoolToInstallGlyphConverter}}" 
                                  Foreground="{x:Bind IsOpenHoYoShadeInstalled, Mode=OneWay, Converter={StaticResource BoolToInstallColorConverter}}" />
                        <TextBlock Grid.Column="1" FontSize="13">
                            <Run Text="OpenHoYoShade"/>
                            <Run Text="{x:Bind OpenHoYoShadeVersionDisplay, Mode=OneWay}" 
                                 Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Language Selector moved below installation status -->
            <ComboBox Name="ComboBox_Language"
                      MinWidth="200"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="ComboBox_Language_SelectionChanged" />

            <Button HorizontalAlignment="Stretch"
                    Content="{x:Bind lang:Lang.WelcomeView_NetworkSettingsButton}"
                    Click="Button_NetworkSettings_Click" />
        </StackPanel>

        <!-- Main Content Area with ScrollViewer for DPI/Resolution adaptation -->
        <ScrollViewer Margin="48,36,48,88"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      MaxWidth="760"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <!-- Title -->
                <TextBlock FontSize="22" 
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           Text="{x:Bind Title, Mode=OneWay}" />

                <!-- Card 1: Version and Channel Configuration -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12">
                    <StackPanel Spacing="8">
                        <!-- Version Selection Row -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind lang:Lang.HoYoShadeDownloadView_SelectVersion}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind lang:Lang.HoYoShadeDownloadView_LatestVersionTip}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{x:Bind Versions}" 
                                      SelectedItem="{x:Bind SelectedVersion, Mode=TwoWay}"
                                      MinWidth="220"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="github:GithubRelease">
                                        <TextBlock>
                                            <Run Text="{x:Bind Name}" />
                                            <Run Text="{x:Bind LatestVersionTag, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- Preview Channel Toggle -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <ToggleSwitch IsOn="{x:Bind EnablePreviewChannel, Mode=TwoWay}"
                                          OffContent="{x:Bind lang:Lang.SettingPage_JoinPreviewReleaseChannel}"
                                          OnContent="{x:Bind lang:Lang.SettingPage_JoinPreviewReleaseChannel}" />
                            <Button Padding="4"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                                <FontIcon FontSize="15"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Glyph="&#xE9CE;" />
                                <Button.Flyout>
                                    <Flyout>
                                        <TextBlock MaxWidth="360"
                                                   Text="{x:Bind lang:Lang.SettingPage_JoinPreviewReleaseChannelTip}"
                                                   TextWrapping="Wrap" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2: Flavor Selection (Visual Comparison Cards) -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind lang:Lang.HoYoShadeDownloadView_SelectType}" 
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Flavor 1: HoYoShade (Standard) -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE790;"
                                              FontSize="16"
                                              Margin="0,0,8,0"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind lang:Lang.HoYoShadeDownloadView_Option_HoYoShade}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2"
                                              IsChecked="{x:Bind IsHoYoShadeSelected, Mode=TwoWay}"
                                              IsEnabled="{x:Bind IsHoYoShadeSelectionEnabled, Mode=OneWay}"
                                              MinWidth="0"
                                              Padding="0"
                                              Margin="0"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{x:Bind lang:Lang.HoYoShadeDownloadView_HoYoShade_Description}"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="11"
                                           LineHeight="16" />
                            </Grid>
                        </Border>

                        <!-- Flavor 2: OpenHoYoShade (Dev Minimal) -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE943;"
                                              FontSize="16"
                                              Margin="0,0,8,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind lang:Lang.HoYoShadeDownloadView_Option_OpenHoYoShade}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2"
                                              IsChecked="{x:Bind IsOpenHoYoShadeSelected, Mode=TwoWay}"
                                              IsEnabled="{x:Bind IsOpenHoYoShadeSelectionEnabled, Mode=OneWay}"
                                              MinWidth="0"
                                              Padding="0"
                                              Margin="0"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{x:Bind lang:Lang.HoYoShadeDownloadView_OpenHoYoShade_Description}"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="11"
                                           LineHeight="16" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Card 3: Download Action & Progress Control Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Control Buttons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                <Button Content="{x:Bind DownloadButtonText, Mode=OneWay}" 
                                        Command="{x:Bind DownloadCommand}" 
                                        Style="{ThemeResource AccentButtonStyle}" 
                                        IsEnabled="{x:Bind CanDownload, Mode=OneWay}"
                                        CornerRadius="6" />
                                
                                <Button Command="{x:Bind RefreshVersionsCommand}"
                                        IsEnabled="{x:Bind CanRefresh, Mode=OneWay}"
                                        Visibility="{x:Bind ShowRefreshButton, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind lang:Lang.Common_Refresh}"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                        <TextBlock Text="{x:Bind lang:Lang.Common_Refresh}" />
                                    </StackPanel>
                                </Button>
                                
                                <Button Command="{x:Bind PauseResumeCommand}"
                                        Visibility="{x:Bind ShowPauseResumeButton, Mode=OneWay}"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Glyph="&#xE769;" />
                                        <TextBlock Text="{x:Bind PauseResumeButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                
                                <Button Command="{x:Bind StopCommand}"
                                        Visibility="{x:Bind IsControlButtonsVisible, Mode=OneWay}"
                                        IsEnabled="{x:Bind CanStop, Mode=OneWay}"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Glyph="&#xE71A;" />
                                        <TextBlock Text="{x:Bind lang:Lang.DownloadGamePage_Stop}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Server Selection (Aligned on the right of the control card) -->
                            <StackPanel Grid.Column="2" 
                                        Orientation="Horizontal" 
                                        Spacing="8" 
                                        VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind lang:Lang.HoYoShadeDownloadView_DownloadServer}" 
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{x:Bind DownloadServers}" 
                                          SelectedItem="{x:Bind SelectedDownloadServer, Mode=TwoWay}" 
                                          MinWidth="180"
                                          VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:DownloadServerItem">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" 
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4" 
                                                        Padding="6,2" 
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind LatencyText, Mode=OneWay, Converter={StaticResource WhiteSpaceStringToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Bind LatencyText, Mode=OneWay}" Foreground="{x:Bind LatencyColor, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" UseLayoutRounding="True" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Progress and Status -->
                        <StackPanel Spacing="4">
                            <ProgressBar Value="{x:Bind DownloadProgress, Mode=OneWay}" 
                                         Maximum="100" 
                                         Height="4"
                                         CornerRadius="2" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind StatusMessage, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind SpeedAndProgress, Mode=OneWay}"
                                           FontSize="12"
                                           FontFamily="Consolas"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Unified Bottom Navigation Bar -->
        <Grid Canvas.ZIndex="10"
              Margin="48,0,80,36"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Import from Local Button (Left) -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <TextBlock Text="{x:Bind lang:Lang.HoYoShadeDownloadView_ImportFromLocal}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <Button Command="{x:Bind ImportFromLocalCommand}"
                        IsEnabled="{x:Bind CanImport, Mode=OneWay}"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="13" Glyph="&#xE8E5;" />
                        <TextBlock Text="{x:Bind lang:Lang.HoYoShadeDownloadView_SelectPackage}" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Next Step Button (Right) -->
            <Button Grid.Column="2"
                    Height="40"
                    BorderThickness="0"
                    Command="{x:Bind StartCommand}"
                    IsEnabled="{x:Bind CanStart, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    CornerRadius="8,20,20,8">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,0,6,0">
                    <TextBlock FontSize="14" Text="{x:Bind lang:Lang.HoYoShadeDownloadView_Next}" />
                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
