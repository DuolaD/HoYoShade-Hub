<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="HoYoShadeHub.Features.Setting.AboutSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cw="using:CommunityToolkit.WinUI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:HoYoShadeHub.Language"
             xmlns:local="using:HoYoShadeHub.Features.Setting"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:HoYoShadeHub.Models"
             xmlns:s="using:HoYoShadeHub"
             xmlns:sf="using:HoYoShadeHub.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Page.Resources>
        <cw:AttachedDropShadow x:Key="LogoShadow"
                               CastTo="{x:Bind Border_LogoShadow}"
                               Opacity="0.4"
                               Offset="4" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="0,0,0,20">

            <!--  Logo  -->
            <Grid>
                <Border Name="Border_LogoShadow" />
                <Image Width="120"
                       Height="120"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       cw:Effects.Shadow="{StaticResource LogoShadow}"
                       Source="ms-appx:///Assets/logo.png" />
            </Grid>

            <TextBlock Margin="0,24,0,0"
                       FontSize="24"
                       FontWeight="Bold"
                       Text="HoYoShade Hub" />
            <TextBlock Margin="0,4,0,0" Text="Developed by HoYoShade Hub Team, all rights reserved." />


            <!--  当前版本  -->
            <StackPanel Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="4">
                <TextBlock Text="{x:Bind lang:Lang.SettingPage_CurrentVersion}" />
                <TextBlock FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           Text="{x:Bind s:AppConfig.AppVersion}" />
            </StackPanel>


            <!--  预览版更新  -->
            <StackPanel Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                <ToggleSwitch IsOn="{x:Bind EnablePreviewRelease, Mode=TwoWay}"
                              OffContent="{x:Bind lang:Lang.SettingPage_JoinPreviewReleaseChannel}"
                              OnContent="{x:Bind lang:Lang.SettingPage_JoinPreviewReleaseChannel}" />
                <Button Margin="0,2,0,0"
                        Padding="4"
                        VerticalAlignment="Center"
                        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                    <FontIcon FontSize="16"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Glyph="&#xE9CE;" />
                    <Button.Flyout>
                        <Flyout>
                            <TextBlock MaxWidth="380"
                                       Text="{x:Bind lang:Lang.SettingPage_JoinPreviewReleaseChannelTip}"
                                       TextWrapping="Wrap" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <ToggleSwitch Margin="0,8,0,0"
                          IsOn="{x:Bind AutoCheckLauncherUpdateOnStartup, Mode=TwoWay}"
                          OffContent="{x:Bind AutoCheckUpdatesText, Mode=OneWay}"
                          OnContent="{x:Bind AutoCheckUpdatesText, Mode=OneWay}" />
            
            <!--  下载服务器选择  -->
            <TextBlock Margin="0,12,0,4"
                       Text="{x:Bind lang:Lang.HoYoShadeDownloadView_DownloadServer}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox MinWidth="240"
                      HorizontalAlignment="Left"
                      ItemsSource="{x:Bind DownloadServers}"
                      SelectedItem="{x:Bind SelectedDownloadServer, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadServerItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Border Grid.Column="1" 
                                     Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                     BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                     BorderThickness="1"
                                     CornerRadius="4" 
                                     Padding="6,2" 
                                     VerticalAlignment="Center"
                                     Visibility="{x:Bind LatencyText, Mode=OneWay, Converter={StaticResource WhiteSpaceStringToVisibilityConverter}}">
                                 <TextBlock Text="{x:Bind LatencyText, Mode=OneWay}" Foreground="{x:Bind LatencyColor, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" UseLayoutRounding="True" />
                             </Border>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            
            <Grid Margin="0,12,0,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  检查更新  -->
                <Button Height="40"
                        Padding="12,0,16,0"
                        BorderThickness="0"
                        Command="{x:Bind CheckUpdateCommand}"
                        CornerRadius="4,20,20,4"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE752;" />
                        <TextBlock Text="{x:Bind lang:Lang.SettingPage_CheckForUpdate}" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <FontIcon HorizontalAlignment="Left"
                              FontSize="20"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              Glyph="&#xF78C;"
                              Visibility="{x:Bind IsUpdated}" />
                    <ProgressRing Width="20"
                                  Height="20"
                                  HorizontalAlignment="Left"
                                  IsIndeterminate="{x:Bind CheckUpdateCommand.IsRunning}"
                                  Visibility="{x:Bind CheckUpdateCommand.IsRunning}" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind UpdateInfoText, Mode=OneWay}"
                               Visibility="{x:Bind UpdateInfoText, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind UpdateErrorText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>


            <!--  环境与日志诊断  -->
            <TextBlock Margin="0,20,0,0"
                       FontSize="20"
                       Text="{x:Bind lang:Lang.AboutSetting_ExportDiagnosticInfo}" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.AboutSetting_ExportDiagnosticInfoTip}"
                       TextWrapping="Wrap" />
            <Button Height="40"
                    Margin="0,12,0,0"
                    Padding="16,0,16,0"
                    BorderThickness="0"
                    Command="{x:Bind OpenDiagnosticToolCommand}"
                    CornerRadius="8,20,20,8"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9F9;" />
                    <TextBlock Text="{x:Bind lang:Lang.AboutSetting_OpenDiagnosticTool}" />
                </StackPanel>
            </Button>


            <!--  相关链接  -->
            <TextBlock Margin="0,20,0,0"
                       FontSize="20"
                       Text="{x:Bind lang:Lang.AboutSettingPage_Links}" />
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/DuolaD/HoYoShade-Hub" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.SettingPage_ProjectHomepage}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/DuolaD/HoYoShade-Hub/issues" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.SettingPage_ReportIssue}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/DuolaD/HoYoShade-Hub/releases" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.SettingPage_ReleaseHistroy}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://hoyosha.de/user-agreement.html" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.SettingPage_PrivacyPolicy}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/DuolaD/" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.SettingPage_Donate}" />
                </Hyperlink>
            </TextBlock>





        </StackPanel>
    </ScrollViewer>

</sf:PageBase>
