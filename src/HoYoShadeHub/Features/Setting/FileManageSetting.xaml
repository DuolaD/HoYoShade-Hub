<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="HoYoShadeHub.Features.Setting.FileManageSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:HoYoShadeHub.Language"
             xmlns:local="using:HoYoShadeHub.Features.Setting"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:HoYoShadeHub.Models"
             xmlns:s="using:HoYoShadeHub"
             xmlns:sf="using:HoYoShadeHub.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="0,0,0,20" Padding="0,0,24,0">


            <!--  用户数据文件夹  -->
            <TextBlock FontSize="20" Text="{x:Bind lang:Lang.FileSettingPage_DataFolder}" />
            <TextBlock Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.FileSettingPage_DataFolderIsImportant}"
                       TextWrapping="Wrap" />
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <!--  重新选择  -->
                <Button Grid.Column="0"
                        Height="40"
                        Padding="16,0,16,0"
                        BorderThickness="0"
                        Command="{x:Bind ChangeUserDataFolderCommand}"
                        CornerRadius="8,20,20,8"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8DE;" />
                        <TextBlock Text="{x:Bind lang:Lang.SettingPage_ReselectDataFolder}" />
                    </StackPanel>
                </Button>
                <!--  当前用户数据文件夹  -->
                <Button Grid.Column="1"
                        Height="40"
                        Margin="16,0,0,0"
                        Padding="20,0,20,1"
                        BorderThickness="0"
                        Command="{x:Bind OpenUserDataFolderCommand}"
                        CornerRadius="20">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextTrimmedChanged="TextBlock_IsTextTrimmedChanged"
                                   MaxLines="2"
                                   Text="{x:Bind s:AppConfig.UserDataFolder}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />
                        <FontIcon Grid.Column="1"
                                  Margin="0,2,2,0"
                                  FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Glyph="&#xE8A7;" />
                    </Grid>
                </Button>
            </Grid>


            <!--  备份数据库  -->
            <StackPanel Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Spacing="16">
                <Button Height="40"
                        Margin="0,0,0,0"
                        Padding="16,0,16,0"
                        BorderThickness="0"
                        Command="{x:Bind BackupDatabaseCommand}"
                        CornerRadius="8,20,20,8"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xF413;" />
                        <TextBlock Text="{x:Bind lang:Lang.SettingPage_BackupDatabase}" />
                    </StackPanel>
                </Button>
                <ProgressRing Width="28"
                              Height="28"
                              IsIndeterminate="{x:Bind BackupDatabaseCommand.IsRunning}"
                              Visibility="{x:Bind BackupDatabaseCommand.IsRunning}" />
                <Button Height="40"
                        Padding="20,0,20,1"
                        BorderThickness="0"
                        Command="{x:Bind OpenLastBackupDatabaseCommand}"
                        CornerRadius="20"
                        Visibility="{x:Bind LastDatabaseBackupTime, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind LastDatabaseBackupTime}" />
                        <FontIcon Margin="8,2,2,0"
                                  FontSize="16"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Glyph="&#xE8A7;" />
                    </StackPanel>
                </Button>
            </StackPanel>


            <!--  删除所有设置  -->
            <Button Height="40"
                    Margin="0,8,0,0"
                    Padding="16,0,16,0"
                    BorderThickness="0"
                    Command="{x:Bind DeleteAllSettingCommand}"
                    CornerRadius="8,20,20,8"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" />
                    <TextBlock Text="{x:Bind lang:Lang.SettingPage_DeleteAllSettings}" />
                </StackPanel>
            </Button>

            <!--  HoYoShade框架  -->
            <TextBlock Margin="0,24,0,0"
                       FontSize="20"
                       Text="{x:Bind lang:Lang.FileSettingPage_HoYoShadeFramework}" />

            <!--  Card 1: 框架通用设置与网络分发  -->
            <Border Margin="0,12,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12">
                <StackPanel Spacing="12">
                    <!-- 下载服务器选择行 -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="15"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Glyph="&#xE774;" />
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind lang:Lang.HoYoShadeDownloadView_DownloadServer}" />
                            </StackPanel>
                        </StackPanel>
                        
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{x:Bind DownloadServers}"
                                  SelectedItem="{x:Bind SelectedDownloadServer, Mode=TwoWay}"
                                  MinWidth="240"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:DownloadServerItem">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" 
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4" 
                                                Padding="6,2" 
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind LatencyText, Mode=OneWay, Converter={StaticResource WhiteSpaceStringToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind LatencyText, Mode=OneWay}" Foreground="{x:Bind LatencyColor, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" UseLayoutRounding="True" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <!-- 预览体验计划 -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleSwitch IsOn="{x:Bind EnableHoYoShadePreviewChannel, Mode=TwoWay}"
                                      OffContent="{x:Bind lang:Lang.SettingPage_JoinPreviewReleaseChannel}"
                                      OnContent="{x:Bind lang:Lang.SettingPage_JoinPreviewReleaseChannel}" />
                        <Button Margin="0,-4,0,0"
                                Padding="4"
                                VerticalAlignment="Center"
                                Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                            <FontIcon FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE9CE;" />
                            <Button.Flyout>
                                <Flyout>
                                    <TextBlock MaxWidth="380"
                                               Text="{x:Bind lang:Lang.SettingPage_JoinPreviewReleaseChannelTip}"
                                               TextWrapping="Wrap" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Card: 框架与组件快速安装  -->
            <Border Margin="0,12,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：图标与标题说明 -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <FontIcon FontSize="16"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  Glyph="&#xE896;" />
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{x:Bind lang:Lang.HoYoShadeDownloadView_DownloadAndInstall}" />
                    </StackPanel>

                    <!-- 右侧：安装操作按钮 -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Height="36"
                                Padding="14,0"
                                Command="{x:Bind InstallHoYoShadeFrameworkCommand}"
                                CornerRadius="6"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE896;" />
                                <TextBlock Text="{x:Bind lang:Lang.FileSettingPage_InstallHoYoShadeFramework}" />
                            </StackPanel>
                        </Button>

                        <Button Height="36"
                                Padding="14,0"
                                Command="{x:Bind InstallReShadeShadersCommand}"
                                CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE896;" />
                                <TextBlock Text="{x:Bind lang:Lang.FileSettingPage_InstallReShadeShadersAndAddons}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Card 2: HoYoShade 框架卡片  -->
            <Border Margin="0,12,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <StackPanel Spacing="14">
                    <!-- 卡片头部：信息与主操作 -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：图标、名称、状态徽章、版本 -->
                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="18"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          Glyph="&#xE896;" />
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="HoYoShade" />
                                <!-- 状态徽章 -->
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontSize="10"
                                                  Foreground="{x:Bind HoYoShadeInstalled, Converter={StaticResource BoolToColorConverter}, Mode=OneWay}"
                                                  Glyph="{x:Bind HoYoShadeInstalled, Converter={StaticResource BoolToInstallGlyphConverter}, Mode=OneWay}" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{x:Bind HoYoShadeInstalled, Converter={StaticResource BoolToColorConverter}, Mode=OneWay}"
                                                   Text="{x:Bind HoYoShadeInstalled, Converter={StaticResource BoolToInstallStatusTextConverter}, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 版本信息（已安装时展示） -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="16"
                                        Visibility="{x:Bind HoYoShadeInstalled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind lang:Lang.FileSettingPage_FrameworkVersion}" /><Run Text=": " />
                                    <Run FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind HoYoShadeVersion, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind lang:Lang.FileSettingPage_ReShadeVersion}" /><Run Text=": " />
                                    <Run FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind HoYoShadeReShadeVersion, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- 右侧主操作：已安装显示检查更新 -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind HoYoShadeInstalled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <ProgressRing Width="18"
                                          Height="18"
                                          IsIndeterminate="{x:Bind CheckHoYoShadeUpdateCommand.IsRunning}"
                                          Visibility="{x:Bind CheckHoYoShadeUpdateCommand.IsRunning}" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind HoYoShadeUpdateInfo, Mode=OneWay}"
                                       Visibility="{x:Bind HoYoShadeUpdateInfo, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}" />
                            <SplitButton x:Name="HoYoShadeSplitButton"
                                         Height="36"
                                         Padding="12,0"
                                         Command="{x:Bind CheckHoYoShadeUpdateCommand}"
                                         CornerRadius="6">
                                <SplitButton.Resources>
                                    <StaticResource x:Key="SplitButtonBackground" ResourceKey="AccentFillColorDefaultBrush" />
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                    <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                                    <StaticResource x:Key="SplitButtonForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundSecondary" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundSecondaryPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundSecondaryPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrush" ResourceKey="AccentControlElevationBorderBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushPointerOver" ResourceKey="AccentControlElevationBorderBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushPressed" ResourceKey="AccentControlElevationBorderBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushDivider" ResourceKey="CircleElevationBorderBrush" />
                                </SplitButton.Resources>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE752;" />
                                    <TextBlock Text="{x:Bind lang:Lang.SettingPage_CheckForUpdate}" />
                                </StackPanel>
                                <SplitButton.Flyout>
                                    <Flyout x:Name="HoYoShadeFlyout"
                                            Placement="BottomEdgeAlignedRight"
                                            Opening="FrameworkFlyout_Opening"
                                            Opened="FrameworkFlyout_Opened"
                                            Closed="FrameworkFlyout_Closed">
                                        <ToggleSwitch IsOn="{x:Bind AutoCheckHoYoShadeUpdateOnStartup, Mode=TwoWay}"
                                                      OffContent="{x:Bind AutoCheckUpdatesText, Mode=OneWay}"
                                                      OnContent="{x:Bind AutoCheckUpdatesText, Mode=OneWay}" />
                                    </Flyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                        </StackPanel>
                    </Grid>

                    <!-- 卡片主体（仅在已安装时显示） -->
                    <StackPanel Spacing="12"
                                Visibility="{x:Bind HoYoShadeInstalled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <!-- 路径展示按钮 -->
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="12,8"
                                Command="{x:Bind OpenHoYoShadeFolderCommand}"
                                CornerRadius="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Glyph="&#xED25;" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           IsTextTrimmedChanged="TextBlock_IsTextTrimmedChanged"
                                           MaxLines="1"
                                           Text="{x:Bind HoYoShadePath, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                                <FontIcon Grid.Column="2"
                                          FontSize="13"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Glyph="&#xE8A7;" />
                            </Grid>
                        </Button>

                        <!-- 存储占用面板 -->
                        <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,10">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon FontSize="13"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Glyph="&#xEDA2;" />
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind lang:Lang.FileSettingPage_TotalSize}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               Text="{x:Bind HoYoShadeTotalSize, Mode=OneWay}" />
                                </Grid>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 着色器及插件 -->
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind lang:Lang.FileSettingPage_ShaderAndAddonSize}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="13"
                                                   FontWeight="Medium"
                                                   Text="{x:Bind HoYoShadeShaderSize, Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- 预设 -->
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind lang:Lang.FileSettingPage_PresetSize}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="13"
                                                   FontWeight="Medium"
                                                   Text="{x:Bind HoYoShadePresetSize, Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- 截图 -->
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind lang:Lang.FileSettingPage_ScreenshotSize}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="13"
                                                   FontWeight="Medium"
                                                   Text="{x:Bind HoYoShadeScreenshotSize, Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- 其它内容 -->
                                    <StackPanel Grid.Column="3" Spacing="2">
                                        <TextBlock FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind lang:Lang.FileSettingPage_OtherContentSize}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="13"
                                                   FontWeight="Medium"
                                                   Text="{x:Bind HoYoShadeOtherSize, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 工具栏与卸载操作 -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧：日常维护工具 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Button Height="34"
                                        Padding="12,0"
                                        Command="{x:Bind ResetHoYoShadeReShadeIniCommand}"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Glyph="&#xE777;" />
                                        <TextBlock FontSize="12" Text="{x:Bind lang:Lang.FileSettingPage_ResetReShadeIni}" />
                                    </StackPanel>
                                </Button>

                                <Button Height="34"
                                        Padding="12,0"
                                        Command="{x:Bind CustomInjectHoYoShadeCommand}"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Glyph="&#xE73F;" />
                                        <TextBlock FontSize="12" Text="{x:Bind lang:Lang.FileSettingPage_CustomInject}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 右侧：卸载与清理 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Height="34"
                                        Padding="12,0"
                                        Command="{x:Bind UninstallHoYoShadeShadersCommand}"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  Glyph="&#xE74D;" />
                                        <TextBlock FontSize="12" Text="{x:Bind lang:Lang.FileSettingPage_UninstallShadersAndPlugins}" />
                                    </StackPanel>
                                </Button>

                                <Button Height="34"
                                        Padding="12,0"
                                        Command="{x:Bind UninstallHoYoShadeCommand}"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  Glyph="&#xE74D;" />
                                        <TextBlock FontSize="12" Text="{x:Bind lang:Lang.FileSettingPage_UninstallHoYoShade}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Card 3: OpenHoYoShade 框架卡片  -->
            <Border Margin="0,12,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <StackPanel Spacing="14">
                    <!-- 卡片头部：信息与主操作 -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：图标、名称、状态徽章、版本 -->
                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="18"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          Glyph="&#xE896;" />
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="OpenHoYoShade" />
                                <!-- 状态徽章 -->
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontSize="10"
                                                  Foreground="{x:Bind OpenHoYoShadeInstalled, Converter={StaticResource BoolToColorConverter}, Mode=OneWay}"
                                                  Glyph="{x:Bind OpenHoYoShadeInstalled, Converter={StaticResource BoolToInstallGlyphConverter}, Mode=OneWay}" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{x:Bind OpenHoYoShadeInstalled, Converter={StaticResource BoolToColorConverter}, Mode=OneWay}"
                                                   Text="{x:Bind OpenHoYoShadeInstalled, Converter={StaticResource BoolToInstallStatusTextConverter}, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 版本信息（已安装时展示） -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="16"
                                        Visibility="{x:Bind OpenHoYoShadeInstalled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind lang:Lang.FileSettingPage_FrameworkVersion}" /><Run Text=": " />
                                    <Run FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind OpenHoYoShadeVersion, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind lang:Lang.FileSettingPage_ReShadeVersion}" /><Run Text=": " />
                                    <Run FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind OpenHoYoShadeReShadeVersion, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- 右侧主操作：已安装显示检查更新 -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind OpenHoYoShadeInstalled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <ProgressRing Width="18"
                                          Height="18"
                                          IsIndeterminate="{x:Bind CheckOpenHoYoShadeUpdateCommand.IsRunning}"
                                          Visibility="{x:Bind CheckOpenHoYoShadeUpdateCommand.IsRunning}" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind OpenHoYoShadeUpdateInfo, Mode=OneWay}"
                                       Visibility="{x:Bind OpenHoYoShadeUpdateInfo, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}" />
                            <SplitButton x:Name="OpenHoYoShadeSplitButton"
                                         Height="36"
                                         Padding="12,0"
                                         Command="{x:Bind CheckOpenHoYoShadeUpdateCommand}"
                                         CornerRadius="6">
                                <SplitButton.Resources>
                                    <StaticResource x:Key="SplitButtonBackground" ResourceKey="AccentFillColorDefaultBrush" />
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                    <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                                    <StaticResource x:Key="SplitButtonForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundSecondary" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundSecondaryPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundSecondaryPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrush" ResourceKey="AccentControlElevationBorderBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushPointerOver" ResourceKey="AccentControlElevationBorderBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushPressed" ResourceKey="AccentControlElevationBorderBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushDivider" ResourceKey="CircleElevationBorderBrush" />
                                </SplitButton.Resources>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE752;" />
                                    <TextBlock Text="{x:Bind lang:Lang.SettingPage_CheckForUpdate}" />
                                </StackPanel>
                                <SplitButton.Flyout>
                                    <Flyout x:Name="OpenHoYoShadeFlyout"
                                            Placement="BottomEdgeAlignedRight"
                                            Opening="FrameworkFlyout_Opening"
                                            Opened="FrameworkFlyout_Opened"
                                            Closed="FrameworkFlyout_Closed">
                                        <ToggleSwitch IsOn="{x:Bind AutoCheckOpenHoYoShadeUpdateOnStartup, Mode=TwoWay}"
                                                      OffContent="{x:Bind AutoCheckUpdatesText, Mode=OneWay}"
                                                      OnContent="{x:Bind AutoCheckUpdatesText, Mode=OneWay}" />
                                    </Flyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                        </StackPanel>
                    </Grid>

                    <!-- 卡片主体（仅在已安装时显示） -->
                    <StackPanel Spacing="12"
                                Visibility="{x:Bind OpenHoYoShadeInstalled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <!-- 路径展示按钮 -->
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="12,8"
                                Command="{x:Bind OpenOpenHoYoShadeFolderCommand}"
                                CornerRadius="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Glyph="&#xED25;" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           IsTextTrimmedChanged="TextBlock_IsTextTrimmedChanged"
                                           MaxLines="1"
                                           Text="{x:Bind OpenHoYoShadePath, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                                <FontIcon Grid.Column="2"
                                          FontSize="13"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Glyph="&#xE8A7;" />
                            </Grid>
                        </Button>

                        <!-- 存储占用面板 -->
                        <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,10">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon FontSize="13"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Glyph="&#xEDA2;" />
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind lang:Lang.FileSettingPage_TotalSize}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               Text="{x:Bind OpenHoYoShadeTotalSize, Mode=OneWay}" />
                                </Grid>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 着色器及插件 -->
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind lang:Lang.FileSettingPage_ShaderAndAddonSize}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="13"
                                                   FontWeight="Medium"
                                                   Text="{x:Bind OpenHoYoShadeShaderSize, Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- 预设 -->
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind lang:Lang.FileSettingPage_PresetSize}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="13"
                                                   FontWeight="Medium"
                                                   Text="{x:Bind OpenHoYoShadePresetSize, Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- 截图 -->
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind lang:Lang.FileSettingPage_ScreenshotSize}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="13"
                                                   FontWeight="Medium"
                                                   Text="{x:Bind OpenHoYoShadeScreenshotSize, Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- 其它内容 -->
                                    <StackPanel Grid.Column="3" Spacing="2">
                                        <TextBlock FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind lang:Lang.FileSettingPage_OtherContentSize}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="13"
                                                   FontWeight="Medium"
                                                   Text="{x:Bind OpenHoYoShadeOtherSize, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 工具栏与卸载操作 -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧：日常维护工具 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Button Height="34"
                                        Padding="12,0"
                                        Command="{x:Bind ResetOpenHoYoShadeReShadeIniCommand}"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Glyph="&#xE777;" />
                                        <TextBlock FontSize="12" Text="{x:Bind lang:Lang.FileSettingPage_ResetReShadeIni}" />
                                    </StackPanel>
                                </Button>

                                <Button Height="34"
                                        Padding="12,0"
                                        Command="{x:Bind CustomInjectOpenHoYoShadeCommand}"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Glyph="&#xE73F;" />
                                        <TextBlock FontSize="12" Text="{x:Bind lang:Lang.FileSettingPage_CustomInject}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 右侧：卸载与清理 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Height="34"
                                        Padding="12,0"
                                        Command="{x:Bind UninstallOpenHoYoShadeShadersCommand}"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  Glyph="&#xE74D;" />
                                        <TextBlock FontSize="12" Text="{x:Bind lang:Lang.FileSettingPage_UninstallShadersAndPlugins}" />
                                    </StackPanel>
                                </Button>

                                <Button Height="34"
                                        Padding="12,0"
                                        Command="{x:Bind UninstallOpenHoYoShadeCommand}"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  Glyph="&#xE74D;" />
                                        <TextBlock FontSize="12" Text="{x:Bind lang:Lang.FileSettingPage_UninstallOpenHoYoShade}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

			<!--  日志  -->
			<TextBlock Margin="0,20,0,0"
                       FontSize="20"
                       Text="{x:Bind lang:Lang.FileSettingPage_Log}" />
			<!--  打开日志文件夹  -->
			<Button Height="40"
                    Margin="0,8,0,0"
                    Padding="16,0,16,0"
                    BorderThickness="0"
                    Command="{x:Bind OpenLogFolderCommand}"
                    CornerRadius="8,20,20,8"
                    Style="{ThemeResource AccentButtonStyle}">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<FontIcon Glyph="&#xE838;" />
					<TextBlock Text="{x:Bind lang:Lang.SettingPage_OpenLogFolder}" />
				</StackPanel>
			</Button>
			<!--  缓存  -->
            <TextBlock Margin="0,20,0,0"
                       FontSize="20"
                       Text="{x:Bind lang:Lang.FileSettingPage_Cache}" />
            <StackPanel Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Spacing="20">
                <TextBlock>
                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind lang:Lang.FileSettingPage_Log}" />
                    <LineBreak />
                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind lang:Lang.FileSettingPage_Image}" />
                    <LineBreak />
                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind lang:Lang.FileSettingPage_Browser}" />
                    <LineBreak />
                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind lang:Lang.FileSettingPage_GameResource}" />
                </TextBlock>
                <TextBlock>
                    <Run Text="{x:Bind LogCacheSize}" />
                    <LineBreak />
                    <Run Text="{x:Bind ImageCacheSize}" />
                    <LineBreak />
                    <Run Text="{x:Bind WebCacheSize}" />
                    <LineBreak />
                    <Run Text="{x:Bind GameCacheSize}" />
                </TextBlock>
            </StackPanel>
            <!--  清理缓存  -->
            <StackPanel Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="16">
                <Button Height="40"
                        Padding="16,0,16,0"
                        BorderThickness="0"
                        Command="{x:Bind ClearCacheCommand}"
                        CornerRadius="8,20,20,8"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEA99;" />
                        <TextBlock Text="{x:Bind lang:Lang.FileSettingPage_ClearCache}" />
                    </StackPanel>
                </Button>
                <ProgressRing Width="28"
                              Height="28"
                              VerticalAlignment="Center"
                              IsIndeterminate="{x:Bind ClearCacheCommand.IsRunning}"
                              Visibility="{x:Bind ClearCacheCommand.IsRunning}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</sf:PageBase>
